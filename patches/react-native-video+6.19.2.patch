+//
+//  RCTUpNextInfoViewController.swift
+//
+//  TomoTV patch: custom "Up Next" tab for the tvOS video player's swipe-down
+//  info panel (AVPlayerViewController.customInfoViewControllers). Shows the
+//  app-provided upcoming items (episodes/videos) as focusable 16:9 cards;
+//  selecting one fires the onSelect callback with the item id and the app
+//  jumps playback there.
+//
+//  Reload discipline: reloadData while the panel is on screen strands
+//  previously-focused cells in UIKit's lifted (floating-focus) appearance, so
+//  entry updates are DEFERRED and applied on the next presentation
+//  (viewWillAppear runs before focus lands on any cell).
+//
+
+#if os(tvOS)
+
+    import UIKit
+
+    class RCTUpNextInfoViewController: UIViewController, UICollectionViewDataSource, UICollectionViewDelegateFlowLayout {
+        struct Entry {
+            let id: String
+            let title: String
+            let subtitle: String
+            let imageUri: String
+            /// Primary image width over height, nil when the server reported none.
+            let aspectRatio: CGFloat?
+            /// A station logo (usually transparent): drawn fitted on an elevated tile, not cropped to fill.
+            var logo: Bool = false
+        }
+
+        var onSelect: ((String) -> Void)?
+
+        /// Holds the finished card images, not the raw downloads: the
+        /// decode-and-round pass is the expensive half and repeating it every
+        /// time a cell scrolls back into view would show on the focus engine's
+        /// runloop.
+        private static let imageCache: NSCache<NSString, UIImage> = {
+            let cache = NSCache<NSString, UIImage>()
+            cache.countLimit = 60
+            return cache
+        }()
+
+        private var entries: [Entry] = []
+        private var pendingEntries: [Entry]?
+        private var collectionView: UICollectionView?
+
+        // AVKit builds the info panel's tab bar from the child controllers'
+        // title/preferredContentSize WITHOUT loading their views — set in init,
+        // not viewDidLoad, or the tab renders blank.
+        override init(nibName nibNameOrNil: String?, bundle nibBundleOrNil: Bundle?) {
+            super.init(nibName: nibNameOrNil, bundle: nibBundleOrNil)
+            title = "Up Next"
+            preferredContentSize = CGSize(width: 1920, height: 400)
+        }
+
+        @available(*, unavailable)
+        required init?(coder _: NSCoder) {
+            fatalError("init(coder:) is not supported")
+        }
+
+        override func viewDidLoad() {
+            super.viewDidLoad()
+            view.backgroundColor = .clear
+        }
+
+        /// Store new entries; the list materializes fresh on the panel's next
+        /// presentation (see rebuildCollectionView).
+        func setEntries(_ newEntries: [Entry]) {
+            pendingEntries = newEntries
+        }
+
+        // Focus-strand discipline: a cell removed from the window while focused
+        // (panel dismissed over it) keeps its lifted floating-focus appearance
+        // forever — UIKit never delivers the focus-out — and reappears zoomed on
+        // the next open until focus passes over it again. Resetting flags or
+        // deferring reloadData does NOT clear it. The only reset guaranteed by
+        // construction: no view survives across presentations. Build the
+        // collection view fresh on every appearance, destroy it on disappear.
+        // Bonus: every open shows the current queue.
+        private func rebuildCollectionView() {
+            collectionView?.removeFromSuperview()
+
+            if let newEntries = pendingEntries {
+                entries = newEntries
+                pendingEntries = nil
+            }
+
+            let layout = UICollectionViewFlowLayout()
+            layout.scrollDirection = .horizontal
+            layout.minimumLineSpacing = 40
+            layout.sectionInset = UIEdgeInsets(top: 20, left: 90, bottom: 20, right: 90)
+
+            let cv = UICollectionView(frame: .zero, collectionViewLayout: layout)
+            cv.backgroundColor = .clear
+            cv.dataSource = self
+            cv.delegate = self
+            cv.register(RCTUpNextInfoCell.self, forCellWithReuseIdentifier: RCTUpNextInfoCell.reuseIdentifier)
+            cv.translatesAutoresizingMaskIntoConstraints = false
+            view.addSubview(cv)
+            NSLayoutConstraint.activate([
+                cv.topAnchor.constraint(equalTo: view.topAnchor),
+                cv.leadingAnchor.constraint(equalTo: view.leadingAnchor),
+                cv.trailingAnchor.constraint(equalTo: view.trailingAnchor),
+                cv.bottomAnchor.constraint(equalTo: view.bottomAnchor),
+            ])
+            collectionView = cv
+        }
+
+        override func viewWillAppear(_ animated: Bool) {
+            super.viewWillAppear(animated)
+            rebuildCollectionView()
+        }
+
+        override func viewDidDisappear(_ animated: Bool) {
+            super.viewDidDisappear(animated)
+            collectionView?.removeFromSuperview()
+            collectionView = nil
+        }
+
+        // MARK: - UICollectionViewDataSource
+
+        func collectionView(_: UICollectionView, numberOfItemsInSection _: Int) -> Int {
+            entries.count
+        }
+
+        func collectionView(_ collectionView: UICollectionView, cellForItemAt indexPath: IndexPath) -> UICollectionViewCell {
+            let cell = collectionView.dequeueReusableCell(withReuseIdentifier: RCTUpNextInfoCell.reuseIdentifier, for: indexPath)
+            guard let upNextCell = cell as? RCTUpNextInfoCell, indexPath.item < entries.count else { return cell }
+            let entry = entries[indexPath.item]
+            let artworkSize = UpNextArtwork.size(for: entry.aspectRatio)
+            upNextCell.configure(title: entry.title, subtitle: entry.subtitle, imageUri: entry.imageUri, artworkSize: artworkSize, logo: entry.logo)
+            loadImage(uri: entry.imageUri, size: artworkSize, logo: entry.logo, into: upNextCell)
+            return cell
+        }
+
+        // MARK: - UICollectionViewDelegateFlowLayout
+
+        /// Every card shares one height; the width follows the item's own image shape.
+        func collectionView(_: UICollectionView, layout _: UICollectionViewLayout, sizeForItemAt indexPath: IndexPath) -> CGSize {
+            let ratio = indexPath.item < entries.count ? entries[indexPath.item].aspectRatio : nil
+            let artwork = UpNextArtwork.size(for: ratio)
+            return CGSize(width: artwork.width, height: artwork.height + RCTUpNextInfoCell.captionHeight)
+        }
+
+        // MARK: - UICollectionViewDelegate
+
+        func collectionView(_: UICollectionView, didSelectItemAt indexPath: IndexPath) {
+            guard indexPath.item < entries.count else { return }
+            onSelect?(entries[indexPath.item].id)
+        }
+
+        // MARK: - Images
+
+        private func loadImage(uri: String, size: CGSize, logo: Bool, into cell: RCTUpNextInfoCell) {
+            guard !uri.isEmpty, let url = URL(string: uri) else { return }
+            // Keyed by geometry too: the same poster is a different bitmap at another card size.
+            let cacheKey = "\(uri)@\(Int(size.width))x\(Int(size.height))\(logo ? "#logo" : "")" as NSString
+            if let cached = Self.imageCache.object(forKey: cacheKey) {
+                cell.setArtwork(cached)
+                return
+            }
+            URLSession.shared.dataTask(with: url) { [weak cell] data, _, _ in
+                // Still on URLSession's queue: decode and round here, hand the
+                // finished card to main.
+                guard let data, !data.isEmpty, let image = UIImage(data: data),
+                      let card = logo ? UpNextArtwork.logoCard(from: image, size: size) : UpNextArtwork.card(from: image, size: size) else { return }
+                Self.imageCache.setObject(card, forKey: cacheKey)
+                DispatchQueue.main.async {
+                    guard let cell, cell.representedUri == uri else { return }
+                    cell.setArtwork(card)
+                }
+            }.resume()
+        }
+    }
+
+    /// Card artwork, baked to the card's exact geometry with rounded corners.
+    ///
+    /// Two tvOS focus rules force the drawing to happen here instead of on the
+    /// layer:
+    ///
+    ///  - `adjustsImageWhenAncestorFocused` builds the lift, parallax and
+    ///    specular sweep FROM the image. A card with no image has nothing to
+    ///    animate and sits dead under focus, so every card gets an image —
+    ///    artwork when the item has one, the placeholder when it doesn't (the
+    ///    app omits imageUri entirely for items with no Primary image).
+    ///  - `layer.cornerRadius` cannot round the artwork. CALayer applies the
+    ///    radius to the layer's background and to the `masksToBounds` mask only
+    ///    (CALayer.h), and the focus effect requires `clipsToBounds = false`, so
+    ///    the image itself always drew square-cornered. Baking the corners into
+    ///    the image and setting `masksFocusEffectToContents` masks the focus
+    ///    shadow and highlight to the alpha channel rather than the bounds.
+    ///    UIImageView.h requires the view and its image to share an aspect ratio
+    ///    for that to take effect, which drawing at the card size guarantees.
+    enum UpNextArtwork {
+        static let height: CGFloat = 180
+        static let defaultRatio: CGFloat = 16 / 9
+        static let cornerRadius: CGFloat = 12
+
+        /// The card for an image shape: one shared height, width from the ratio.
+        static func size(for ratio: CGFloat?) -> CGSize {
+            let safe = ratio.map { $0.isFinite && $0 > 0 ? $0 : defaultRatio } ?? defaultRatio
+            return CGSize(width: (height * safe).rounded(), height: height)
+        }
+
+        /// Matches the posterless cards in the library grid (`video-grid-item.tsx`).
+        private static let placeholderFill = UIColor(red: 44 / 255, green: 44 / 255, blue: 46 / 255, alpha: 1)
+        private static let placeholderGlyph = UIColor(red: 72 / 255, green: 72 / 255, blue: 74 / 255, alpha: 1)
+
+        /// One per card width, drawn on first use. Main thread only: cells ask for it.
+        private static var placeholders: [CGFloat: UIImage] = [:]
+
+        static func placeholder(for size: CGSize) -> UIImage {
+            if let cached = placeholders[size.width] { return cached }
+            let drawn = render(size: size) { _ in
+                placeholderFill.setFill()
+                UIBezierPath(rect: CGRect(origin: .zero, size: size)).fill()
+                let config = UIImage.SymbolConfiguration(pointSize: 56, weight: .regular)
+                guard let glyph = UIImage(systemName: "video.fill", withConfiguration: config)?
+                    .withTintColor(placeholderGlyph, renderingMode: .alwaysOriginal) else { return }
+                glyph.draw(at: CGPoint(x: (size.width - glyph.size.width) / 2,
+                                       y: (size.height - glyph.size.height) / 2))
+            }
+            placeholders[size.width] = drawn
+            return drawn
+        }
+
+        /// The station tile: a dark surface with a hairline, the logo fitted inside it. Logos come
+        /// as transparent PNGs, so drawn straight over the video they read as loose shapes.
+        private static let tileFill = UIColor(red: 124 / 255, green: 124 / 255, blue: 128 / 255, alpha: 1)
+        private static let tileLine = UIColor(white: 1, alpha: 0.18)
+
+        static func logoTile(size: CGSize, draw: ((CGRect) -> Void)? = nil) -> UIImage {
+            render(size: size) { _ in
+                tileFill.setFill()
+                UIBezierPath(rect: CGRect(origin: .zero, size: size)).fill()
+                let line = UIBezierPath(roundedRect: CGRect(origin: .zero, size: size).insetBy(dx: 0.5, dy: 0.5), cornerRadius: cornerRadius)
+                line.lineWidth = 1
+                tileLine.setStroke()
+                line.stroke()
+                draw?(CGRect(origin: .zero, size: size).insetBy(dx: size.width * 0.16, dy: size.height * 0.2))
+            }
+        }
+
+        /// One per card width, like the poster placeholder.
+        private static var logoPlaceholders: [CGFloat: UIImage] = [:]
+
+        static func logoPlaceholder(for size: CGSize) -> UIImage {
+            if let cached = logoPlaceholders[size.width] { return cached }
+            let drawn = logoTile(size: size) { inset in
+                let config = UIImage.SymbolConfiguration(pointSize: 48, weight: .regular)
+                guard let glyph = UIImage(systemName: "tv", withConfiguration: config)?
+                    .withTintColor(placeholderGlyph, renderingMode: .alwaysOriginal) else { return }
+                glyph.draw(at: CGPoint(x: inset.midX - glyph.size.width / 2, y: inset.midY - glyph.size.height / 2))
+            }
+            logoPlaceholders[size.width] = drawn
+            return drawn
+        }
+
+        /// The info panel's artwork for a station: the logo on a 16:9 tile, as PNG bytes for the
+        /// player item's metadata. Main thread: the renderer format reads the screen.
+        static func logoArtwork(pngData: Data) -> Data? {
+            guard let image = UIImage(data: pngData) else { return nil }
+            return logoCard(from: image, size: CGSize(width: 640, height: 360))?.pngData()
+        }
+
+        /// The logo fitted inside the tile's inset, centred, never cropped.
+        static func logoCard(from image: UIImage, size: CGSize) -> UIImage? {
+            guard image.size.width > 0, image.size.height > 0 else { return nil }
+            return logoTile(size: size) { inset in
+                let scale = min(inset.width / image.size.width, inset.height / image.size.height)
+                let drawn = CGSize(width: image.size.width * scale, height: image.size.height * scale)
+                image.draw(in: CGRect(x: inset.midX - drawn.width / 2, y: inset.midY - drawn.height / 2, width: drawn.width, height: drawn.height))
+            }
+        }
+
+        /// Centre-cropped to fill the card (what `.scaleAspectFill` used to do
+        /// at display time), then clipped to the rounded rect.
+        static func card(from image: UIImage, size: CGSize) -> UIImage? {
+            guard image.size.width > 0, image.size.height > 0 else { return nil }
+            return render(size: size) { _ in
+                let scale = max(size.width / image.size.width, size.height / image.size.height)
+                let drawn = CGSize(width: image.size.width * scale, height: image.size.height * scale)
+                image.draw(in: CGRect(x: (size.width - drawn.width) / 2,
+                                      y: (size.height - drawn.height) / 2,
+                                      width: drawn.width,
+                                      height: drawn.height))
+            }
+        }
+
+        /// Built once, off the screen traits, so `card(from:size:)` never touches
+        /// them from URLSession's queue. Safe by ordering: the first access is
+        /// a placeholder, which every cell renders in its initializer on the
+        /// main thread, and a cell always exists before any download completes.
+        private static let format: UIGraphicsImageRendererFormat = {
+            let format = UIGraphicsImageRendererFormat.preferred()
+            format.opaque = false // the corners have to stay transparent
+            return format
+        }()
+
+        private static func render(size: CGSize, _ body: @escaping (UIGraphicsImageRendererContext) -> Void) -> UIImage {
+            UIGraphicsImageRenderer(size: size, format: format).image { context in
+                UIBezierPath(roundedRect: CGRect(origin: .zero, size: size), cornerRadius: cornerRadius).addClip()
+                body(context)
+            }
+        }
+    }
+
+    private final class RCTUpNextInfoCell: UICollectionViewCell {
+        static let reuseIdentifier = "RCTUpNextInfoCell"
+        /// Title and subtitle rows under the artwork.
+        static let captionHeight: CGFloat = 110
+
+        private let imageView = UIImageView()
+        private let titleLabel = UILabel()
+        private let subtitleLabel = UILabel()
+        private(set) var representedUri: String?
+        private var artworkSize = UpNextArtwork.size(for: nil)
+        private var artworkWidth: NSLayoutConstraint!
+        private var artworkHeight: NSLayoutConstraint!
