+//
+//  RCTContentProposalViewController.swift
+//
+//  TomoTV patch: native tvOS "Up Next" proposal UI (AVContentProposal).
+//  Presented by AVPlayerViewController at the proposal's transition time
+//  (credits start when the app supplies a marker, else end of item). The
+//  video keeps playing full screen behind; this lays a bottom-trailing card
+//  with the next item's poster, title, and Play Now / Close actions. The
+//  countdown runs from playback end + automaticAcceptanceInterval and drives
+//  the acceptance itself (AVKit's own automatic acceptance never fires here —
+//  see the anchor comment below).
+//
+
+#if os(tvOS)
+
+    import AVKit
+    import UIKit
+
+    class RCTContentProposalViewController: AVContentProposalViewController {
+        private let dimView = UIView()
+        private let posterView = UIImageView()
+        private let upNextLabel = UILabel()
+        private let titleLabel = UILabel()
+        private let countdownLabel = UILabel()
+        private let playButton = UIButton(type: .system)
+        private let closeButton = UIButton(type: .system)
+        private var countdownTimer: Timer?
+        private weak var playbackItem: AVPlayerItem?
+        private var endObserver: NSObjectProtocol?
+        private var acceptanceInterval: TimeInterval?
+        private var isAppearing = false
+        private weak var lastFocusedButton: UIButton?
+
+        // Playback-end anchor for the countdown AND for the acceptance itself.
+        // AVKit's automatic acceptance does not happen here: tvOS 26 leaves
+        // dateOfAutomaticAcceptance at .distantFuture (never scheduling), and
+        // react-native-video pauses the player and zeroes its rate the instant
+        // the item ends, so there is no timeline left for AVKit to count on.
+        // The card would sit at "Playing in 1…" forever. So the deadline is
+        // ours: end-notification time + automaticAcceptanceInterval, and the
+        // countdown reaching zero accepts through the same call the Play Now
+        // button makes. Bound before playback, since the end can arrive before
+        // the proposal's view lifecycle runs.
+        private var playbackEndDate: Date?
+
+        // Manual actions and timer expiry share one dismissal, including the
+        // animation window before viewWillDisappear stops the timer.
+        private var didFinish = false
+
+        /// Called when the player item or proposal config changes, before the card appears.
+        /// Artwork/setting updates for the same item must preserve its end time and focus.
+        func configure(for item: AVPlayerItem?, automaticAcceptanceInterval: TimeInterval?) {
+            if playbackItem !== item {
+                if let endObserver { NotificationCenter.default.removeObserver(endObserver) }
+                endObserver = nil
+                playbackItem = item
+                playbackEndDate = nil
+                didFinish = false
+                lastFocusedButton = nil
+                stopCountdown()
+                if let item {
+                    endObserver = NotificationCenter.default.addObserver(
+                        forName: .AVPlayerItemDidPlayToEndTime, object: item, queue: .main
+                    ) { [weak self, weak item] _ in
+                        guard let self, let item, self.playbackItem === item else { return }
+                        self.playerItemDidPlayToEnd()
+                    }
+                }
+            }
+            acceptanceInterval = automaticAcceptanceInterval.flatMap {
+                $0.isFinite && $0 > 0 && $0 < Double(Int.max) ? $0 : nil
+            }
+            // This card owns acceptance. Do not leave AVKit's separate timer armed
+            // when a late preference update switches automatic playback off.
+            if isAppearing { dateOfAutomaticAcceptance = nil }
+            updateEndAppearance()
+            updateCountdownTimer()
+        }
+
+        deinit {
+            if let endObserver { NotificationCenter.default.removeObserver(endObserver) }
+            countdownTimer?.invalidate()
+        }
+
+        private func playerItemDidPlayToEnd() {
+            guard playbackEndDate == nil else { return }
+            playbackEndDate = Date()
+            updateEndAppearance()
+            updateCountdownTimer()
+            restoreCardFocusIfNeeded()
+        }
+
+        private func updateEndAppearance() {
+            viewIfLoaded?.backgroundColor = playbackEndDate == nil ? .clear : .black
+        }
+
+        override func viewDidLoad() {
+            super.viewDidLoad()
+            updateEndAppearance()
+
+            // Bottom gradient scrim so the card reads over bright outros.
+            dimView.translatesAutoresizingMaskIntoConstraints = false
+            let gradient = CAGradientLayer()
+            gradient.colors = [UIColor.clear.cgColor, UIColor.black.withAlphaComponent(0.85).cgColor]
+            gradient.locations = [0, 1]
+            dimView.layer.addSublayer(gradient)
+            view.addSubview(dimView)
+
+            posterView.translatesAutoresizingMaskIntoConstraints = false
+            posterView.contentMode = .scaleAspectFill
+            posterView.clipsToBounds = true
+            posterView.layer.cornerRadius = 10
+            posterView.backgroundColor = UIColor(white: 0.15, alpha: 1)
+            view.addSubview(posterView)
+
+            upNextLabel.translatesAutoresizingMaskIntoConstraints = false
+            upNextLabel.text = "Up Next"
+            upNextLabel.font = .systemFont(ofSize: 26, weight: .bold)
+            upNextLabel.textColor = UIColor(white: 1, alpha: 0.7)
+            view.addSubview(upNextLabel)
+
+            titleLabel.translatesAutoresizingMaskIntoConstraints = false
+            titleLabel.font = .systemFont(ofSize: 34, weight: .semibold)
+            titleLabel.textColor = .white
+            titleLabel.numberOfLines = 2
+            view.addSubview(titleLabel)
+
+            countdownLabel.translatesAutoresizingMaskIntoConstraints = false
+            countdownLabel.font = .systemFont(ofSize: 24)
+            countdownLabel.textColor = UIColor(white: 1, alpha: 0.7)
+            countdownLabel.text = ""
+            view.addSubview(countdownLabel)
+
+            playButton.translatesAutoresizingMaskIntoConstraints = false
+            playButton.setTitle("Play Now", for: .normal)
+            playButton.addTarget(self, action: #selector(acceptProposal), for: .primaryActionTriggered)
+            view.addSubview(playButton)
+
+            closeButton.translatesAutoresizingMaskIntoConstraints = false
+            closeButton.setTitle("Close", for: .normal)
+            closeButton.addTarget(self, action: #selector(rejectProposal), for: .primaryActionTriggered)
+            view.addSubview(closeButton)
+
+            NSLayoutConstraint.activate([
+                dimView.leadingAnchor.constraint(equalTo: view.leadingAnchor),
+                dimView.trailingAnchor.constraint(equalTo: view.trailingAnchor),
+                dimView.bottomAnchor.constraint(equalTo: view.bottomAnchor),
+                dimView.heightAnchor.constraint(equalToConstant: 480),
+
+                posterView.leadingAnchor.constraint(equalTo: view.leadingAnchor, constant: 90),
+                posterView.bottomAnchor.constraint(equalTo: view.bottomAnchor, constant: -80),
+                posterView.widthAnchor.constraint(equalToConstant: 200),
+                posterView.heightAnchor.constraint(equalToConstant: 300),
+
+                upNextLabel.leadingAnchor.constraint(equalTo: posterView.trailingAnchor, constant: 40),
+                upNextLabel.topAnchor.constraint(equalTo: posterView.topAnchor, constant: 8),
+
+                titleLabel.leadingAnchor.constraint(equalTo: upNextLabel.leadingAnchor),
+                titleLabel.topAnchor.constraint(equalTo: upNextLabel.bottomAnchor, constant: 10),
+                titleLabel.trailingAnchor.constraint(lessThanOrEqualTo: view.trailingAnchor, constant: -90),
+
+                countdownLabel.leadingAnchor.constraint(equalTo: upNextLabel.leadingAnchor),
+                countdownLabel.topAnchor.constraint(equalTo: titleLabel.bottomAnchor, constant: 10),
+
+                playButton.leadingAnchor.constraint(equalTo: upNextLabel.leadingAnchor),
+                playButton.bottomAnchor.constraint(equalTo: posterView.bottomAnchor),
+                closeButton.leadingAnchor.constraint(equalTo: playButton.trailingAnchor, constant: 40),
+                closeButton.bottomAnchor.constraint(equalTo: playButton.bottomAnchor),
+            ])
+        }
+
+        override func viewDidLayoutSubviews() {
+            super.viewDidLayoutSubviews()
+            (dimView.layer.sublayers?.first as? CAGradientLayer)?.frame = dimView.bounds
+        }
+
+        override var preferredFocusEnvironments: [UIFocusEnvironment] { [lastFocusedButton ?? playButton] }
+
+        override func didUpdateFocus(in context: UIFocusUpdateContext, with coordinator: UIFocusAnimationCoordinator) {
+            super.didUpdateFocus(in: context, with: coordinator)
+            if context.nextFocusedView === playButton { lastFocusedButton = playButton }
+            if context.nextFocusedView === closeButton { lastFocusedButton = closeButton }
+        }
+
+        private func restoreCardFocusIfNeeded() {
+            guard isAppearing, viewIfLoaded?.window != nil, !playButton.isFocused, !closeButton.isFocused else { return }
+            setNeedsFocusUpdate()
+            playerViewController?.setNeedsFocusUpdate()
+            playerViewController?.updateFocusIfNeeded()
+            updateFocusIfNeeded()
+        }
+
+        override func viewWillAppear(_ animated: Bool) {
+            super.viewWillAppear(animated)
+            titleLabel.text = contentProposal?.title
+            posterView.image = contentProposal?.previewImage
+            isAppearing = true
+            didFinish = false
+            dateOfAutomaticAcceptance = nil
+            updateEndAppearance()
+            updateCountdownTimer()
+        }
+
+        override func viewDidAppear(_ animated: Bool) {
+            super.viewDidAppear(animated)
+            restoreCardFocusIfNeeded()
+        }
+
+        override func viewWillDisappear(_ animated: Bool) {
+            super.viewWillDisappear(animated)
+            isAppearing = false
+            stopCountdown()
+        }
+
+        private func stopCountdown() {
+            countdownTimer?.invalidate()
+            countdownTimer = nil
+            countdownLabel.text = ""
+        }
+
+        private func updateCountdownTimer() {
+            guard isAppearing, !didFinish, secondsToAcceptance() != nil else {
+                stopCountdown()
+                return
+            }
+            updateCountdown()
+            guard !didFinish, countdownTimer == nil else { return }
+            // Keep counting through focus movement, which can stall a default-mode timer.
+            let timer = Timer(timeInterval: 0.5, repeats: true) { [weak self] _ in
+                self?.updateCountdown()
+            }
+            RunLoop.main.add(timer, forMode: .common)
+            countdownTimer = timer
+        }
+
+        private func updateCountdown() {
+            guard let remaining = secondsToAcceptance() else {
+                stopCountdown()
+                return
+            }
+            if remaining <= 0 {
+                countdownLabel.text = ""
+                finish(with: .accept)
+                return
+            }
+            countdownLabel.text = "Playing in \(remaining)…"
+        }
+
+        /// Seconds left until acceptance, or nil while the item is still playing
+        /// (an early proposal over the outro has no deadline yet — credits run
+        /// to the end first).
+        private func secondsToAcceptance() -> Int? {
+            guard let end = playbackEndDate, let interval = acceptanceInterval else { return nil }
+            return Int(exactly: max(0, ceil(interval - Date().timeIntervalSince(end))))
+        }
+
+        /// The countdown running out is the transition: same dismissal the Play
+        /// Now button makes, so the delegate's didAccept — and the queue advance
+        /// in JS behind it — is one code path, not two. Anything that takes the
+        /// panel down first (Play Now, Close, a deferral) stops the timer in
+        /// viewWillDisappear, which is what "unless interrupted" means here.
+        private func finish(with action: AVContentProposalAction) {
+            guard !didFinish else { return }
+            didFinish = true
+            stopCountdown()
+            dateOfAutomaticAcceptance = nil
+            dismissContentProposal(for: action, animated: true, completion: nil)
+        }
+
+        @objc private func acceptProposal() {
+            finish(with: .accept)
+        }
+
+        @objc private func rejectProposal() {
+            finish(with: .reject)
+        }
+    }
+
+#endif
