+
+        // TomoTV patch: AVContentProposal (native Up Next) delegate. Accept and
+        // reject are BOTH forwarded to JS, which owns the queue advance and the
+        // route pop — native never swaps player items. didReject is implemented
+        // deliberately: AVKit's default for an unimplemented didReject is to
+        // dismiss the player view controller, which is an embedded child here,
+        // not a presentation.
+        func playerViewController(_: AVPlayerViewController, shouldPresent _: AVContentProposal) -> Bool {
+            true
+        }
+
+        func playerViewController(_: AVPlayerViewController, didAccept _: AVContentProposal) {
+            _handlers?.handleContentProposalAccepted()
+        }
+
+        func playerViewController(_: AVPlayerViewController, didReject _: AVContentProposal) {
+            _handlers?.handleContentProposalRejected()
+        }
+    #endif
