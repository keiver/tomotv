{
  "expo": {
    "name": "Tomo TV",
    "slug": "tomotv",
    "description": "Stream any video from your Jellyfin server. Automatic transcoding handles incompatible formats so you can just hit play and watch.",
    "version": "2.0.0",
    "orientation": "default",
    "icon": "./assets/images/icon.png",
    "scheme": "tomotv",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#1C1C1E",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "dev.keiver.tomotv",
      "buildNumber": "1",
      "version": "2.0.0",
      "config": {
        "usesNonExemptEncryption": false
      },
      "entitlements": {
        "keychain-access-groups": ["$(AppIdentifierPrefix)dev.keiver.tomotv"]
      },
      "infoPlist": {
        "UIUserInterfaceStyle": "Dark",
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": true,
          "NSAllowsArbitraryLoadsForMedia": true,
          "NSAllowsLocalNetworking": true
        },
        "NSLocalNetworkUsageDescription": "Tomo TV needs access to your local network to find and connect to your Jellyfin media server and stream your videos."
      }
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/input-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#1C1C1E"
        }
      ],
      [
        "@react-native-tvos/config-tv",
        {
          "tvosDeploymentTarget": "16.4"
        }
      ],
      "expo-secure-store",
      "./plugins/withMultiAudioResourceLoader",
      "./plugins/withMPVKit",
      "./plugins/withTVImageAssets",
      "./plugins/withTopShelfExtension",
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "android": {
      "package": "dev.keiver.tomotv"
    }
  }
}
