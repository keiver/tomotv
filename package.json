{
  "name": "tomotv",
  "version": "2.2.2",
  "description": "Stream videos from your Jellyfin server on Apple TV with automatic transcoding",
  "main": "expo-router/entry",
  "author": "Keiver Hernandez <contact@keiver.dev>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/keiver/tomotv.git"
  },
  "bugs": {
    "url": "https://github.com/keiver/tomotv/issues"
  },
  "homepage": "https://keiver.dev/lab/tomotv",
  "keywords": [
    "jellyfin",
    "tvos",
    "apple-tv",
    "react-native",
    "video-player",
    "streaming",
    "expo",
    "transcoding",
    "mkv",
    "media-server",
    "media-center",
    "home-theater"
  ],
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "scripts": {
    "postinstall": "patch-package --error-on-fail && node scripts/fetch-ffmpeg.js && node scripts/generate-licenses.mjs --if-stale && bash scripts/check-cocoapods.sh",
    "fetch:ffmpeg": "node scripts/fetch-ffmpeg.js",
    "build:ffmpeg": "bash scripts/ffmpeg/build.sh",
    "prestart": "bash scripts/check-firewall.sh",
    "start": "expo start --dev-client",
    "logs": "xcrun simctl spawn booted log stream --style compact --predicate '(process == \"TomoTV\" AND eventType == logEvent AND NOT (subsystem BEGINSWITH \"com.apple\")) OR subsystem BEGINSWITH \"dev.keiver.tomotv\"'",
    "android": "expo run:android",
    "ios": "expo run:ios --scheme \"$(basename -s .xcscheme ios/*.xcodeproj/xcshareddata/xcschemes/*.xcscheme | head -1)\"",
    "lint": "eslint . && prettier --check .",
    "lint:fix": "eslint . --fix && prettier --write .",
    "licenses": "node scripts/generate-licenses.mjs",
    "licenses:check": "node scripts/generate-licenses.mjs --check",
    "test": "jest",
    "test:playback": "node scripts/playback-regression.mjs",
    "test:playback:preflight": "node scripts/playback-regression.mjs --preflight",
    "test:playback:manifest": "node scripts/playback-regression.mjs --verify-manifest",
    "bench:transcode": "node scripts/transcode-bench.mjs",
    "report:playback": "node scripts/playback-report.mjs",
    "make:test-media": "node scripts/make-test-media.mjs",
    "probe:codecs": "node scripts/probe-codecs.mjs",
    "test:engine": "swift test --package-path native/ios",
    "shots": "node scripts/appstore-shots.mjs",
    "test:shots": "node scripts/appstore-shots.mjs --self-check",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "prebuild:tv": "EXPO_TV=1 expo prebuild --clean",
    "prebuild:dual": "EXPO_TV=1 expo prebuild --clean --platform ios --no-install && rm -rf tvos && mv ios tvos && cd tvos && EXPO_TV=1 pod install && cd .. && expo prebuild --clean --platform ios && bash scripts/make-dual-workspace.sh",
    "prebuild": "expo prebuild --clean",
    "prebuild:ios": "expo prebuild --clean",
    "clearios": "bash scripts/clear.sh --npm --ios",
    "both": "EXPO_TV=1 expo prebuild --clean && EXPO_TV=1 expo run:ios --device \"Apple TV 4K (3rd generation)\" --no-bundler && expo prebuild --clean && expo run:ios --device \"iPhone 16\" --no-bundler && expo start --dev-client",
    "lib": "npm uninstall expo-tvos-search && npm cache clean --force && npm install expo-tvos-search@latest && rm -rf .expo .metro-cache && yes | EXPO_TV=1 npx expo prebuild --clean && bash scripts/check-firewall.sh && npx expo start --clear --dev-client",
    "cleartvos": "bash scripts/clear.sh --npm --tv",
    "clear": "bash scripts/clear.sh",
    "archive": "bash scripts/archive-both.sh",
    "prepare": "husky",
    "probe:pixel-transfer": "node scripts/probe-pixel-transfer.mjs"
  },
  "dependencies": {
    "@expo/metro-runtime": "~56.0.15",
    "@expo/vector-icons": "^15.0.2",
    "entities": "^6.0.1",
    "expo": "^56.0.0",
    "expo-blur": "~56.0.3",
    "expo-clipboard": "~56.0.4",
    "expo-constants": "~56.0.18",
    "expo-file-system": "~56.0.8",
    "expo-font": "~56.0.7",
    "expo-glass-effect": "57.0.1",
    "expo-image": "~56.0.11",
    "expo-linear-gradient": "~56.0.4",
    "expo-linking": "~56.0.14",
    "expo-modules-core": "~56.0.17",
    "expo-router": "~56.2.11",
    "expo-secure-store": "~56.0.4",
    "expo-splash-screen": "~56.0.10",
    "expo-status-bar": "~56.0.4",
    "expo-tvos-search": "^2.3.0",
    "react": "19.2.3",
    "react-native": "npm:react-native-tvos@0.85.0-0",
    "react-native-gesture-handler": "3.1.0",
    "react-native-reanimated": "4.3.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "4.27.0",
    "react-native-video": "^6.19.2",
    "react-native-worklets": "0.8.3"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@react-native-tvos/config-tv": "^0.1.4",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.2.0",
    "@types/react-test-renderer": "^19.1.0",
    "eslint": "^9.39.1",
    "eslint-config-expo": "~56.0.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "globals": "^14.0.0",
    "husky": "^9.1.7",
    "jest": "~29.7.0",
    "jest-expo": "^56.0.0",
    "lint-staged": "^16.3.2",
    "opentype.js": "^2.0.0",
    "patch-package": "^8.0.1",
    "postinstall-postinstall": "^2.1.0",
    "prettier": "^3.6.2",
    "react-test-renderer": "19.2.3",
    "ts-jest": "^29.4.5",
    "tvos-assets": "^1.4.0",
    "typescript": "~5.9.2"
  },
  "expo": {
    "install": {
      "exclude": [
        "react-native",
        "react-native-screens",
        "typescript"
      ]
    }
  },
  "overrides": {
    "react-dom": "19.2.3",
    "react-native": "$react-native"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,mjs,cjs}": [
      "eslint --fix --no-warn-ignored"
    ],
    "*.{json,md,css,yml,yaml}": [
      "prettier --write"
    ]
  },
  "private": true
}
