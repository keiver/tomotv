<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Same single group as the app target (app.json ios.entitlements). expo-secure-store
	     writes without an explicit access group, so its items land in the app's default
	     group = this group — which is what lets the extension read the credentials. -->
	<key>keychain-access-groups</key>
	<array>
		<string>$(AppIdentifierPrefix)dev.keiver.tomotv</string>
	</array>
</dict>
</plist>
