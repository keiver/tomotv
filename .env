# Committed on purpose: these are build-time public values, never secrets.
# Secrets live in .env.playback-test and .env.archive, both gitignored.

# Use React Native's fetch instead of Expo's.
#
# expo/src/winter/runtime.native.ts replaces globalThis.fetch with its own
# implementation unless this is set, so every request in the app runs through
# ExpoFetchModule. That module crashed the app with EXC_BAD_ACCESS when a request
# was in flight as the JS runtime tore down: NativeResponse.state.didset ->
# Promise.reject -> RuntimeScheduler::scheduleTask on a dead runtime. The
# playback regression driver force-quits between items and hit it twice.
#
# Safe to switch: nothing in services/, hooks/, contexts/ or utils/ reads
# response.body, ReadableStream or getReader(), and AbortSignal (used by
# services/jellyfin/http.ts and connection.ts) works in both implementations.
EXPO_PUBLIC_USE_RN_FETCH=1
